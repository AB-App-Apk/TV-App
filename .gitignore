# Gradle and Android build outputs
.gradle/
**/build/
out/

# Local Android SDK configuration (machine-specific)
local.properties

# Android Studio / IntelliJ
.idea/
*.iml

# Generated Android packages and compiled files
*.apk
*.aab
*.ap_
*.dex
*.class

# Local signing material (never commit signing keys or encoded keystores)
*.jks
*.keystore
keystore.b64

# Build metadata generated by the local/CI workflow
version.txt

# Logs, crash dumps, and temporary editor files
*.log
*.hprof
*.tmp
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
